# Copy this file to .env and fill in values. .env is gitignored -- never commit it.

# --- LLM provider ---------------------------------------------------------
# Only required to run genuine discovery (Phase 4/8). Not required to run
# the test suite or a deterministic replay against an already-saved artifact.
ANTHROPIC_API_KEY=
# Set to a current Claude model id (see https://docs.claude.com/en/docs/about-claude/models).
# Left blank deliberately here rather than guessing a specific version string.
MODEL_NAME=

# --- Demo target application ----------------------------------------------
DEMO_APP_BASE_URL=http://127.0.0.1:8000

# --- Safety allowlist -------------------------------------------------------
# Comma-separated hostnames the SurfaceAdapter is permitted to navigate to.
# The agent must not act outside this list (see src/cua/safety).
ALLOWED_DOMAINS=127.0.0.1,localhost

# --- Browser ---------------------------------------------------------------
# true = a real, visible Chromium window (needed for the human-handoff demo,
# since the human must act on the SAME window automation is using).
HEADED=false

# --- Discovery loop bounds ---------------------------------------------------
MAX_DISCOVERY_STEPS=25
STEP_TIMEOUT_MS=10000

# --- Storage -----------------------------------------------------------------
ARTIFACT_DIR=artifacts
EVIDENCE_DIR=evidence
LOG_DIR=logs

LOG_LEVEL=INFO
